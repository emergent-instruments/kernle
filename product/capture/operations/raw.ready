ready: 1
kind: operation
id: capture.op.raw
display_id: kernle.raw
module: capture
name: Kernle.raw(blob, source, tags)
summary: Stores a quick unstructured capture for consolidation to turn into memory later.
params:
  - name: blob
    type: string
    source: The text to capture
    source_kind: parameter
  - name: source
    type: string
    source: Where it came from; defaults to the calling surface
    source_kind: parameter
  - name: tags
    type: list of strings
    source: Caller tags
    source_kind: parameter
returns: The capture id; the existing id when the same text was already captured.
errors:
  - code: too_long
    when: the text is longer than the raw capture limit
  - code: invalid_input
    when: the text is empty after trimming
  - code: kernle_unavailable
    when: Kernle is not initialized for this account, or the stack cannot be opened
auth: The caller's account owns the Kernle home
sequence: capture.seq.raw
owner: crates/kernle-core/src/capture/raw.rs::capture_raw
tags:
  - {tag: cli, text: kernle raw}
  - {tag: mcp, text: memory_raw}
