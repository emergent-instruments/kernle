ready: 1
kind: operation
id: capture.op.auto-capture
display_id: kernle.auto_capture
module: capture
name: Kernle.auto_capture(text, context)
summary: Captures text only when it looks significant, such as a decision, a failure, a correction, or a lesson.
params:
  - name: text
    type: string
    source: Text the agent passes along as it works
    source_kind: parameter
  - name: context
    type: string
    source: What the agent was doing
    source_kind: parameter
returns: The capture id when the text was kept, or a skipped result with the reason.
errors:
  - code: too_long
    when: the text is longer than the raw capture limit
  - code: kernle_unavailable
    when: Kernle is not initialized for this account, or the stack cannot be opened
auth: The caller's account owns the Kernle home
sequence: capture.seq.raw
owner: crates/kernle-core/src/capture/raw.rs::auto_capture
tags:
  - {tag: mcp, text: memory_auto_capture}
  - {tag: python, text: "auto_capture, detect_significance"}
