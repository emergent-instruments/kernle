ready: 1
kind: operation
id: capture.op.raw-search
display_id: kernle.search_raw
module: capture
name: Kernle.search_raw(query, limit) · list_raw(…) · get_raw(id)
summary: Lists, shows, or searches raw captures that have not yet expired.
params:
  - name: query
    type: string
    source: Words to search for
    source_kind: parameter
  - name: unprocessed
    type: boolean
    source: Only captures no consolidation step has turned into memory yet
    source_kind: parameter
  - name: limit
    type: integer
    source: The most captures to return
    source_kind: parameter
returns: Captures with their date, source, trust tier, and which memories came from them.
errors:
  - code: not_found
    when: no capture has the id, including captures that expired
  - code: kernle_unavailable
    when: Kernle is not initialized for this account, or the stack cannot be opened
auth: The caller's account owns the Kernle home
sequence: capture.seq.raw-search
owner: crates/kernle-core/src/capture/raw.rs::search_raw
tags:
  - {tag: cli, text: "kernle raw list, kernle raw show, kernle raw search"}
  - {tag: mcp, text: memory_raw_search}
