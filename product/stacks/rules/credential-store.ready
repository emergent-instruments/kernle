ready: 1
kind: rule
id: stacks.rule.credential-store
display_id: RULE-STACKS-CREDENTIALS
module: stacks
title: How secrets are stored
summary: Secrets live in the OS keychain, or in a private file created with owner-only permissions where no keychain exists.
when: Kernle stores a model API key or a cloud sync key
then: >-
  The secret goes into the OS keychain. On a Linux host without a keychain it
  goes into a credentials file that is created with owner-only permissions in
  one step inside an owner-only folder.
constraints:
  - text: Secrets never appear in the configuration file, logs, error messages, exports, or synced data.
    hard: true
  - text: Displaying a credential shows only a masked form.
    hard: true
constants: [stacks.const.file-modes]
