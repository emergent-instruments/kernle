ready: 1
kind: operation
id: memory.op.playbook
display_id: kernle.playbook
module: memory
name: Kernle.playbook(name, description, steps, triggers, …)
summary: Records a procedure the agent can repeat, and records each use with its outcome.
params:
  - name: name
    type: string
    source: The playbook name
    source_kind: parameter
  - name: description
    type: string
    source: What it accomplishes
    source_kind: parameter
  - name: steps
    type: list of strings
    source: The procedure
    source_kind: parameter
  - name: triggers
    type: list of strings
    source: Situations where it applies
    source_kind: parameter
  - name: failure_modes
    type: list of strings
    source: Known ways it fails
    source_kind: parameter
  - name: recovery_steps
    type: list of strings
    source: What to do when it fails
    source_kind: parameter
  - name: success
    type: boolean
    source: For record_playbook_use, whether this use succeeded
    source_kind: parameter
  - name: derived_from
    type: list of kind:id references
    source: Captures or memories the caller says this came from
    source_kind: parameter
  - name: context
    type: string
    source: Where the memory applies, as the caller describes it
    source_kind: parameter
  - name: context_tags
    type: list of strings
    source: Tags that scope where the memory applies
    source_kind: parameter
  - name: source
    type: string
    source: The person, agent, or source the content came from
    source_kind: parameter
  - name: source_type
    type: string
    source: How the memory was acquired; defaults to direct experience
    source_kind: parameter
returns: The playbook's memory id; a recorded use returns the updated mastery and success rate.
errors:
  - code: invalid_input
    when: a required field is missing or a value is out of range for the kind
  - code: too_long
    when: the content is longer than the content limit
  - code: kernle_unavailable
    when: Kernle is not initialized for this account, or the stack cannot be opened
auth: The caller's account owns the Kernle home
sequence: memory.seq.write
owner: crates/kernle-core/src/memory/write.rs::write_memory
tags:
  - {tag: cli, text: "kernle playbook add, kernle playbook use"}
  - {tag: python, text: "playbook, record_playbook_use"}
