ready: 1
kind: operation
id: memory.op.revise-belief
display_id: kernle.revise_belief
module: memory
name: Kernle.revise_belief(id, …) · supersede_belief(old_id, statement, …) · reinforce_belief(id)
summary: Revises, supersedes, or reinforces a belief, keeping its full history.
params:
  - name: id
    type: string
    source: The belief to revise, supersede, or reinforce
    source_kind: parameter
  - name: action
    type: string
    source: revise, supersede, reinforce, or from_episode
    source_kind: parameter
  - name: statement
    type: string
    source: The new statement, for supersede
    source_kind: parameter
  - name: confidence
    type: number
    source: The new confidence, for revise
    source_kind: parameter
  - name: reason
    type: string
    source: Why the belief changed
    source_kind: parameter
  - name: episode_id
    type: string
    source: For revise_beliefs_from_episode, the episode whose evidence is weighed
    source_kind: parameter
returns: >-
  The revised belief's new version, the new belief that supersedes the old one, or for an episode
  the beliefs reinforced and the revisions proposed.
errors:
  - code: not_found
    when: no active belief has this id
  - code: conflict
    when: the belief changed since it was read
  - code: kernle_unavailable
    when: Kernle is not initialized, or the stack cannot be opened
auth: The caller's account owns the Kernle home
sequence: memory.seq.revise-belief
owner: crates/kernle-core/src/memory/revise.rs::revise_belief
tags:
  - {tag: cli, text: "kernle belief revise, kernle belief supersede, kernle belief reinforce"}
  - {tag: python, text: "revise_belief, supersede_belief, reinforce_belief, revise_beliefs_from_episode, get_belief_history"}
