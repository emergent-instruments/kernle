ready: 1
kind: operation
id: memory.op.dump
display_id: kernle.dump
module: memory
name: Kernle.dump(format) · export(path, format) · export_full(path)
summary: Writes a stack's memories as readable markdown or as JSON that imports back without loss.
params:
  - name: format
    type: string
    source: markdown or json
    source_kind: parameter
  - name: path
    type: string
    source: Where to write the export; omitted means standard output
    source_kind: parameter
  - name: include
    type: object
    source: Kinds to include, and whether to include dormant and superseded memories and provenance
    source_kind: parameter
returns: The export text, or the path written and counts by kind.
errors:
  - code: path_refused
    when: the path is inside the Kernle home outside the stack's export folder, or cannot be written
auth: The caller's account owns the Kernle home
sequence: memory.seq.dump
owner: crates/kernle-core/src/memory/dump.rs::dump
tags:
  - {tag: cli, text: "kernle dump, kernle export"}
  - {tag: python, text: "dump, export, export_full, export_cache"}
