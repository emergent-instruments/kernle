ready: 1
kind: operation
id: memory.op.relationship
display_id: kernle.relationship
module: memory
name: Kernle.relationship(entity_name, trust_level, interaction_type, notes, …)
summary: Records or updates the agent's relationship with a person, agent, or organization, and logs the interaction.
params:
  - name: entity_name
    type: string
    source: Who the relationship is with
    source_kind: parameter
  - name: entity_type
    type: string
    source: person, agent, organization, system, or other
    source_kind: parameter
  - name: interaction_type
    type: string
    source: What kind of interaction just happened
    source_kind: parameter
  - name: notes
    type: string
    source: What the agent knows about them
    source_kind: parameter
  - name: trust_level
    type: number
    source: A sentiment from -1 to 1; entity trust itself is kept by trust assessments
    source_kind: parameter
  - name: derived_from
    type: list of kind:id references
    source: Captures or memories the caller says this came from
    source_kind: parameter
  - name: context
    type: string
    source: Where the memory applies, as the caller describes it
    source_kind: parameter
  - name: context_tags
    type: list of strings
    source: Tags that scope where the memory applies
    source_kind: parameter
  - name: source
    type: string
    source: The person, agent, or source the content came from
    source_kind: parameter
  - name: source_type
    type: string
    source: How the memory was acquired; defaults to direct experience
    source_kind: parameter
returns: >-
  The relationship's memory id. A stack holds one relationship per entity name, so each call
  updates it as a new version and raises its interaction count.
errors:
  - code: invalid_input
    when: a required field is missing or a value is out of range for the kind
  - code: too_long
    when: the content is longer than the content limit
  - code: kernle_unavailable
    when: Kernle is not initialized for this account, or the stack cannot be opened
auth: The caller's account owns the Kernle home
sequence: memory.seq.write
owner: crates/kernle-core/src/memory/write.rs::write_memory
tags:
  - {tag: cli, text: kernle relation}
  - {tag: python, text: "relationship, get_relationship_history"}
