ready: 1
kind: operation
id: memory.op.lineage
display_id: kernle.trace_lineage
module: memory
name: Kernle.trace_lineage(memory_type, memory_id) · reverse_trace(…) · get_memory_lineage(…)
summary: Shows what a memory came from, what was derived from it, and which memories have no grounding.
params:
  - name: memory_id
    type: string
    source: The memory to trace
    source_kind: parameter
  - name: direction
    type: string
    source: sources, derived, or both
    source_kind: parameter
  - name: max_depth
    type: integer
    source: How far to follow links, at most the lineage depth limit
    source_kind: parameter
returns: >-
  A tree of linked memories, captures, and events with their relation, date, and trust tier;
  sources that expired appear as expired with no content.
errors:
  - code: not_found
    when: no memory has this id in the caller's stack
auth: The caller's account owns the Kernle home
sequence: memory.seq.lineage
owner: crates/kernle-core/src/memory/lineage.rs::trace
tags:
  - {tag: cli, text: "kernle trace, kernle lineage, kernle orphans"}
  - {tag: python, text: "trace_lineage, reverse_trace, get_memory_lineage, get_ungrounded_memories, get_memories_derived_from"}
